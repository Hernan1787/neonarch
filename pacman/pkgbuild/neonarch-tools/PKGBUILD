# Maintainer: Hernán Alonso Gutiérrez Quesada
# NeonArch — Topic 6: package our own Layer 3 commands with makepkg.
# The files come straight from the repository (bin/), so there is no source=()
# array to download: package() copies them from the repo root ($startdir/../../..).
# Build & install:  cd pacman/pkgbuild/neonarch-tools && makepkg -f && sudo pacman -U ./*.pkg.tar.zst
pkgname=neonarch-tools
pkgver=1.0.0
pkgrel=2
pkgdesc="NeonArch own commands: neon-info, neon-ps, neon-boost, neon-net, neon-mem (read /proc, /sys and use syscalls)"
arch=('any')
url="https://github.com/Hernan1787/neonarch"
license=('MIT')
depends=('python')
optdepends=('hwdata: PCI vendor/device names in neon-info'
            'xdotool: neon-boost --focused (boost the focused window)'
            'libnotify: desktop notifications from neon-boost --focused')

package() {
    local repo
    repo="$(realpath "$startdir/../../..")"
    for cmd in neon-info neon-ps neon-boost neon-net neon-mem; do
        install -Dm755 "$repo/bin/$cmd" "$pkgdir/usr/bin/$cmd"
    done
    install -Dm644 "$repo/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
