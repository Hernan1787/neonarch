! =============================================================================
!  NeonArch — xterm theme (loaded by ~/.xinitrc with xrdb)
!  xterm is rendered on the CPU through X11 (Xft). We use it instead of a
!  GPU-accelerated terminal because the VM's virtual GPU has no 3D support
!  (see docs/bitacora_ia.md, entry 5).
! =============================================================================
XTerm*termName:          xterm-256color
XTerm*locale:            true
XTerm*utf8:              always
XTerm*faceName:          JetBrainsMono Nerd Font
XTerm*faceSize:          11
XTerm*internalBorder:    10
XTerm*scrollBar:         false
XTerm*saveLines:         10000
XTerm*metaSendsEscape:   true
XTerm*selectToClipboard: true
XTerm*cursorBlink:       true
XTerm*pointerShape:      left_ptr

! Ctrl+Shift+C / Ctrl+Shift+V copy and paste (clipboard shared with the host)
XTerm*VT100.translations: #override \n\
    Ctrl Shift <Key>C: copy-selection(CLIPBOARD) \n\
    Ctrl Shift <Key>V: insert-selection(CLIPBOARD)

