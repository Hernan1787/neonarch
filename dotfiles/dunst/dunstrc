# NeonArch — dunst notifications
[global]
    font = JetBrainsMono Nerd Font 10
    origin = top-right
    offset = 14x42
    frame_width = 2
    frame_color = "#00f0ff"
    background = "#0a0a12"
    foreground = "#e6e6ff"
    corner_radius = 0
[urgency_critical]
    frame_color = "#ff2bd6"
    timeout = 0
